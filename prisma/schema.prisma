datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model SystemRole {
  id          String   @id @default(cuid())
  name        String   @unique
  code        String   @unique
  description String?
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  userRoles   UserRole[]
}

model Department {
  id          String   @id @default(cuid())
  name        String   @unique
  code        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  users       User[]
}

model User {
  id            String       @id @default(cuid())
  name          String?
  email         String       @unique
  emailVerified DateTime?
  image         String?
  departmentId  String?
  department    Department?  @relation(fields: [departmentId], references: [id])
  
  roles         UserRole[]
  isGuestViewOnly Boolean    @default(false)

  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  accounts      Account[]
  sessions      Session[]

  requestedSaas SaaRequest[] @relation("SaaRequester")
  approvedSaas  SaaApprovalHistory[]
}

model UserRole {
  id           String     @id @default(cuid())
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleId       String
  role         SystemRole @relation(fields: [roleId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  @@unique([userId, roleId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

enum SaaFormType {
  NEW_ACCOUNT
  MODIFY_ACCESS
  REVOKE_ACCESS
  SYSTEM_CHANGE
}

enum SaaActionType {
  CREATE
  UPDATE
  DELETE
}

enum SaaStatus {
  DRAFT
  PENDING_DEPT_HEAD
  PENDING_FINANCE
  PENDING_GM
  PENDING_IT_VERIFICATION
  APPROVED
  REJECTED
  CANCELLED
}

model SaaRequest {
  id          String      @id @default(cuid())
  ticketNo    String      @unique
  formType    SaaFormType
  actionType  SaaActionType
  status      SaaStatus   @default(DRAFT)
  reason      String      @db.Text
  
  requesterId String
  requester   User        @relation("SaaRequester", fields: [requesterId], references: [id])

  approvalHistories SaaApprovalHistory[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SaaApprovalHistory {
  id           String     @id @default(cuid())
  saaRequestId String
  saaRequest   SaaRequest @relation(fields: [saaRequestId], references: [id], onDelete: Cascade)
  
  approverId   String
  approver     User       @relation(fields: [approverId], references: [id])
  
  step         SaaStatus
  approved     Boolean
  comment      String?    @db.Text

  createdAt    DateTime   @default(now())
}
